Bootstrap: docker
From: nvidia/cuda:12.6.3-devel-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        libegl1 \
        libgl1 \
        libglib2.0-0 \
        libglvnd0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        pkg-config \
        wget \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    wget -qO /tmp/miniforge.sh \
        https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm /tmp/miniforge.sh

    export CONDA_OVERRIDE_CUDA=12.6
    export CUDA_HOME=/usr/local/cuda
    export CUDACXX=/usr/local/cuda/bin/nvcc
    export PATH=/usr/local/cuda/bin:/opt/conda/bin:$PATH
    export TORCH_CUDA_ARCH_LIST="7.0;8.0;9.0+PTX"
    export FORCE_CUDA=1

    ENV_PATH=/opt/conda/envs/utonia
    ENV_BIN=$ENV_PATH/bin
    /opt/conda/bin/mamba create -y -p $ENV_PATH python=3.10 packaging ninja

    export PATH=$ENV_BIN:$PATH
    export CPATH=$ENV_PATH/include:$CPATH
    export LIBRARY_PATH=$ENV_PATH/lib:$LIBRARY_PATH

    $ENV_BIN/pip install --upgrade pip setuptools wheel
    $ENV_BIN/pip install \
        numpy==1.26.4 \
        torch==2.4.1 \
        torchvision==0.19.1 \
        torchaudio==2.4.1 \
        --index-url https://download.pytorch.org/whl/cu124
    $ENV_BIN/pip install \
        torch-scatter \
        -f https://data.pyg.org/whl/torch-2.4.0+cu124.html
    $ENV_BIN/pip install spconv-cu124
    $ENV_BIN/pip install https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.0.8/flash_attn-2.6.3+cu126torch2.4-cp310-cp310-linux_x86_64.whl

    cat <<EOF > /tmp/requirements.txt
scipy
addict
timm
psutil
huggingface_hub
h5py
open3d
matplotlib
opencv-python
camtools
trimesh
natsort
gradio
einops
EOF
    $ENV_BIN/pip install -r /tmp/requirements.txt
    rm /tmp/requirements.txt

    /opt/conda/bin/mamba clean -a -y

    # Force use of the host's NVIDIA driver when executed with --nv.
    find /opt/conda -name "libcuda.so*" -delete 2>/dev/null || true
    find /opt/conda -name "libnvidia-ml.so*" -delete 2>/dev/null || true
    rm -rf /usr/local/cuda/lib64/stubs
    chmod 1777 /dev/shm 2>/dev/null || true

%environment
    export NVIDIA_DRIVER_CAPABILITIES=all
    export PYTHONNOUSERSITE=1
    export PATH=/opt/conda/envs/utonia/bin:/opt/conda/bin:/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/.singularity.d/libs:/usr/local/cuda/lib64:/opt/conda/envs/utonia/lib:$LD_LIBRARY_PATH
    export CUDA_HOME=/usr/local/cuda
    export CPATH=/usr/local/cuda/include:$CPATH
    export C_INCLUDE_PATH=/usr/local/cuda/include:$C_INCLUDE_PATH
    export CPLUS_INCLUDE_PATH=/usr/local/cuda/include:$CPLUS_INCLUDE_PATH
    export LIBRARY_PATH=/usr/local/cuda/lib64:$LIBRARY_PATH
    export TORCH_CUDA_ARCH_LIST="7.0;8.0;9.0+PTX"
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
    export REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
    export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

%help
    Build from this repository root:
        apptainer build utonia.sif utonia.def

    The source checkout is intentionally not included in the image. Bind it at
    runtime, then run the trajectory PCA exporter from the mounted checkout:
        apptainer exec --nv --bind "$PWD:/workspace" utonia.sif \
          bash -lc 'cd /workspace && export PYTHONPATH=./ && \
          python demo/9_pca_joint_trajectory.py --help'

%runscript
    exec /bin/bash "$@"
